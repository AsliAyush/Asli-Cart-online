// Prisma Schema for Asli Cart
// Configured for Neon PostgreSQL with pooled runtime connection and direct migration connection.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  fullName      String
  email         String         @unique
  passwordHash  String
  phone         String?
  avatarUrl     String?
  roleId        String
  isActive      Boolean        @default(true)
  emailVerified Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  role                  Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]
  createdProducts       Product[]       @relation("ProductCreatedBy")
  updatedProducts       Product[]       @relation("ProductUpdatedBy")
  createdOffers         Offer[]         @relation("OfferCreatedBy")
  createdAffiliateLinks AffiliateLink[] @relation("AffiliateLinkCreatedBy")
  cart                  Cart?
  wishlist              Wishlist?
  affiliateClicks       AffiliateClick[]

  @@index([roleId])
  @@index([email])
  @@index([isActive])
  @@map("users")
}

model Role {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  description           String?
  isSystem              Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  users                 User[]
  roleModulePermissions RoleModulePermission[]

  @@index([name])
  @@map("roles")
}

model Module {
  id                String             @id @default(cuid())
  name              String             @unique
  description       String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  modulePermissions ModulePermission[]

  @@index([name])
  @@map("modules")
}

model ModulePermission {
  id                    String                 @id @default(cuid())
  moduleId              String
  permissionKey         String
  permissionName        String
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  module                Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  roleModulePermissions RoleModulePermission[]

  @@unique([moduleId, permissionKey])
  @@index([moduleId])
  @@index([permissionKey])
  @@map("module_permissions")
}

model RoleModulePermission {
  id                 String           @id @default(cuid())
  roleId             String
  modulePermissionId String
  createdAt          DateTime         @default(now())

  role               Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  modulePermission   ModulePermission @relation(fields: [modulePermissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, modulePermissionId])
  @@index([roleId])
  @@index([modulePermissionId])
  @@map("role_module_permissions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  moduleName  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([moduleName])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  parentId    String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Merchant {
  id                 String              @id @default(cuid())
  name               String              @unique
  slug               String              @unique
  websiteUrl         String
  logoUrl            String?
  affiliateNetwork   String              @default("CUELINKS")
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  offers             Offer[]
  discoveredProducts DiscoveredProduct[]
  affiliateClicks    AffiliateClick[]

  @@index([slug])
  @@map("merchants")
}

model Product {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  description      String?
  brand            String?
  categoryId       String
  mainImage        String
  additionalImages String[]       @default([])
  specifications   Json?
  status           String         @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, ARCHIVED
  isAssignedToSmm  Boolean        @default(false)
  createdById      String
  updatedById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy        User           @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy        User?          @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  offers           Offer[]
  priceHistories   PriceHistory[]
  wishlistItems    WishlistItem[]
  affiliateClicks  AffiliateClick[]

  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([createdById])
  @@index([brand])
  @@index([createdAt])
  @@map("products")
}

model Offer {
  id                 String          @id @default(cuid())
  productId          String
  merchantId         String
  title              String
  originalPrice      Decimal         @db.Decimal(10, 2)
  sellingPrice       Decimal         @db.Decimal(10, 2)
  discountPercentage Decimal         @db.Decimal(5, 2)
  currency           String          @default("INR")
  couponCode         String?
  originalUrl        String
  affiliateUrl       String?
  affiliateProvider  String?         @default("CUELINKS") @map("affiliate_provider")
  conversionStatus   String          @default("NOT_CONVERTED") @map("conversion_status") // NOT_CONVERTED, PENDING, CONVERTED, NOT_AFFILIATED, FAILED
  isAffiliated       Boolean         @default(false) @map("is_affiliated")
  lastConvertedAt    DateTime?       @map("last_converted_at")
  conversionError    String?         @map("conversion_error")
  availability       String          @default("IN_STOCK") // IN_STOCK, OUT_OF_STOCK, PRE_ORDER
  status             String          @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, PUBLISHED, REJECTED, PAUSED, EXPIRED
  priceVerifiedAt    DateTime        @default(now())
  priceSource        String          @default("manual") // manual, provider, scraper
  rejectionReason    String?
  startDate          DateTime?
  endDate            DateTime?
  createdById        String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchant           Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  createdBy          User            @relation("OfferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  priceHistories     PriceHistory[]
  affiliateLinks     AffiliateLink[]
  cartItems          CartItem[]
  affiliateClicks    AffiliateClick[]

  @@index([productId])
  @@index([merchantId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@index([status, sellingPrice])
  @@index([productId, status, sellingPrice])
  @@index([conversionStatus])
  @@index([isAffiliated])
  @@map("offers")
}

model PriceHistory {
  id                 String   @id @default(cuid())
  productId          String
  offerId            String?
  price              Decimal  @db.Decimal(10, 2)
  originalPrice      Decimal? @db.Decimal(10, 2)
  discountPercentage Decimal? @db.Decimal(5, 2)
  currency           String   @default("INR")
  source             String   @default("manual")
  recordedAt         DateTime @default(now())

  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  offer              Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([offerId])
  @@index([recordedAt])
  @@map("price_histories")
}

model AffiliateLink {
  id           String          @id @default(cuid())
  offerId      String?
  originalUrl  String
  affiliateUrl String
  provider     String          @default("CUELINKS")
  subId1       String?
  subId2       String?
  status       String          @default("ACTIVE") // ACTIVE, FAILED, PENDING
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  offer           Offer?          @relation(fields: [offerId], references: [id], onDelete: SetNull)
  createdBy       User            @relation("AffiliateLinkCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  affiliateClicks AffiliateClick[]

  @@index([offerId])
  @@index([provider])
  @@index([status])
  @@map("affiliate_links")
}

model DiscoveredProduct {
  id                 String   @id @default(cuid())
  externalId         String
  merchantId         String
  title              String
  brand              String?
  category           String?
  price              Decimal  @db.Decimal(10, 2)
  originalPrice      Decimal? @db.Decimal(10, 2)
  discountPercentage Decimal? @db.Decimal(5, 2)
  currency           String   @default("INR")
  imageUrl           String?
  productUrl         String
  imported           Boolean  @default(false)
  importedProductId  String?
  discoveredAt       DateTime @default(now())

  merchant           Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@unique([merchantId, externalId])
  @@index([merchantId])
  @@index([imported])
  @@map("discovered_products")
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customer   User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  offerId       String
  quantity      Int      @default(1)
  priceSnapshot Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  offer         Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([cartId, offerId])
  @@index([cartId])
  @@index([offerId])
  @@map("cart_items")
}

model Wishlist {
  id         String         @id @default(cuid())
  customerId String         @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  customer   User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
  @@map("wishlist_items")
}

model AffiliateClick {
  id              String         @id @default(cuid())
  customerId      String?
  offerId         String
  productId       String
  merchantId      String
  affiliateLinkId String?
  clickReference  String         @unique
  source          String         @default("direct") // cart, product_detail, search, recommendation
  ipAddress       String?
  userAgent       String?
  clickedAt       DateTime       @default(now())

  customer        User?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  offer           Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchant        Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  affiliateLink   AffiliateLink? @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([offerId])
  @@index([productId])
  @@index([merchantId])
  @@index([clickReference])
  @@index([clickedAt])
  @@map("affiliate_clicks")
}

model CuelinksCampaign {
  id                 String    @id @default(cuid())
  externalCampaignId Int       @unique @map("external_campaign_id")
  name               String
  description        String?   @db.Text
  url                String?
  domain             String?
  image              String?
  accessStatus       String    @default("open") @map("access_status") // open, approval_required, pending, paused, rejected
  payout             String?
  payoutCurrency     String?   @default("INR") @map("payout_currency")
  epc7d              String?   @map("epc_7d")
  epc90d             String?   @map("epc_90d")
  campaignType       String?   @map("campaign_type")
  isFeatured         Boolean   @default(false) @map("is_featured")
  country            String?
  category           String?
  platforms          Json?     // Array of allowed platforms e.g. ["Web", "Mobile Web", "Android App", "iOS App"]
  media              Json?     // Allowed/disallowed media types or channels
  rawMetadata        Json?     @map("raw_metadata") // Full raw API response
  lastSyncedAt       DateTime  @default(now()) @map("last_synced_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([externalCampaignId])
  @@index([accessStatus])
  @@index([name])
  @@index([domain])
  @@index([category])
  @@index([country])
  @@index([lastSyncedAt])
  @@map("cuelinks_campaigns")
}

model CuelinksTransaction {
  id                    String    @id @default(cuid())
  externalTransactionId String    @unique @map("external_transaction_id")
  campaignId            Int?      @map("campaign_id")
  campaignName          String?   @map("campaign_name")
  campaignType          String?   @map("campaign_type")
  transactionDate       DateTime  @map("transaction_date")
  status                String    @default("pending") // pending, validated, payable, claimed, rejected, etc.
  saleAmount            Decimal?  @map("sale_amount") @db.Decimal(14, 2)
  commissionAmount      Decimal?  @map("commission_amount") @db.Decimal(14, 2) // user_commission
  currency              String    @default("UNKNOWN")
  merchantRefId         String?   @map("merchant_ref_id")
  orderId               String?   @map("order_id")
  productName           String?   @map("product_name")
  category              String?
  channelId             Int?      @map("channel_id")
  channelName           String?   @map("channel_name")
  subId                 String?   @map("sub_id")
  subId2                String?   @map("sub_id_2")
  subId3                String?   @map("sub_id_3")
  subId4                String?   @map("sub_id_4")
  subId5                String?   @map("sub_id_5")
  invoiceNumber         String?   @map("invoice_number")
  rawMetadata           Json?     @map("raw_metadata")
  lastSyncedAt          DateTime  @default(now()) @map("last_synced_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([externalTransactionId])
  @@index([transactionDate])
  @@index([status])
  @@index([campaignId])
  @@index([subId])
  @@index([invoiceNumber])
  @@index([updatedAt])
  @@index([lastSyncedAt])
  @@map("cuelinks_transactions")
}

model CuelinksTransactionSyncLog {
  id              String    @id @default(cuid())
  status          String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, FAILED
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")
  updatedSince    DateTime? @map("updated_since")
  recordsFetched  Int       @default(0) @map("records_fetched")
  recordsCreated  Int       @default(0) @map("records_created")
  recordsUpdated  Int       @default(0) @map("records_updated")
  failedRecords   Int       @default(0) @map("failed_records")
  isPartial       Boolean   @default(false) @map("is_partial")
  checkpointPage  Int?      @map("checkpoint_page")
  reachedPageLimit Boolean  @default(false) @map("reached_page_limit")
  lastProcessedDate DateTime? @map("last_processed_date")
  error           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([startedAt])
  @@index([status])
  @@map("cuelinks_transaction_sync_logs")
}


