# Environment Configuration
NODE_ENV=development
PORT=5000

# Neon PostgreSQL Database URLs
# DATABASE_URL: Neon pooled connection string for application runtime (e.g. postgresql://user:pass@ep-xyz-pooler.us-east-2.aws.neon.tech/aslicart?sslmode=require)
DATABASE_URL=postgresql://neondb_owner:npg_placeholder@ep-sample-pooler.us-east-2.aws.neon.tech/aslicart?sslmode=require
# DIRECT_URL: Neon direct unpooled connection string for migrations & Prisma CLI
DIRECT_URL=postgresql://neondb_owner:npg_placeholder@ep-sample.us-east-2.aws.neon.tech/aslicart?sslmode=require

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=super_secret_jwt_access_token_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Super Admin Bootstrap Credentials
ADMIN_BOOTSTRAP_EMAIL=admin@aslicart.com
ADMIN_BOOTSTRAP_PASSWORD=SuperAdmin@AsliCart2026!

# Redis Cache & Infrastructure (Optional/Prepared)
REDIS_URL=redis://localhost:6379

# Client / Frontend URL
FRONTEND_URL=http://localhost:3000

